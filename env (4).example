# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── JWT ──────────────────────────────────────────────────────
# Render auto-generates this if you use render.yaml
JWT_SECRET=your_super_secret_key_change_this

# ─── PostgreSQL ───────────────────────────────────────────────
# Render provides this automatically when a DB is linked
DATABASE_URL=postgresql://user:password@host:5432/students

# ─── Cloudinary ───────────────────────────────────────────────
# Get these from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── CORS ─────────────────────────────────────────────────────
# Your frontend URL (Vercel / Netlify etc.)
# Use * for development, specific URL for production
FRONTEND_URL=https://your-frontend.vercel.app
